{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enableVulnerabilityAlertsWithLabel('security')",
    ":rebaseStalePrs",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Brussels",
  "labels": [
    "renovate"
  ],
  "platformAutomerge": false,
  "automergeType": "pr",
  "automerge": false,
  "ignoreTests": false,
  "packageRules": [
    {
      "description": "Group routine Patchright npm updates for CI-backed manual review",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "npm patch and minor updates"
    },
    {
      "description": "Keep GitHub Actions changes manual because CI also publishes signed images",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": false
    },
    {
      "description": "Keep Docker base-image changes manual",
      "matchDatasources": [
        "docker"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the digest-pinned actionlint Docker image used by workflow lint",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/workflow-lint\\.yml$/"
      ],
      "matchStrings": [
        "ACTIONLINT_IMAGE: \"rhysd/actionlint:(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
